{
  "name": "stock-token-verifier",
  "version": "0.2.0",
  "description": "Stock Token Verifier, BNB Smart Chain edition: which bStocks, Ondo Stocks and xStocks contracts on chain 56 are genuine, which are look-alikes, measured from chain state, the issuers' lists and the Binance Web3 API. CLI, JSON snapshot, static report. Zero dependencies.",
  "private": true,
  "license": "SEE LICENSE IN NOTICE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BonyNode/stock-token-verifier.git"
  },
  "homepage": "https://github.com/BonyNode/stock-token-verifier",
  "bugs": {
    "url": "https://github.com/BonyNode/stock-token-verifier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stv-verify": "bin/stv-verify.mjs"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-clean.mjs",
    "verify": "node bin/stv-verify.mjs",
    "scan": "node bin/stv-verify.mjs scan",
    "report": "node bin/stv-verify.mjs report",
    "probe": "node scripts/probe-binance-w3.mjs"
  },
  "keywords": [
    "bnb-smart-chain",
    "bsc",
    "bstocks",
    "ondo",
    "xstocks",
    "binance-web3-api",
    "authenticity",
    "evm"
  ]
}
